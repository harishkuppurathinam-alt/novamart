    "grammy": "^1.29.0",
    "pdfkit": "^0.15.0",
    "pptxgenjs": "^3.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@types/pdfkit": "^0.13.4",
    "prisma": "^5.19.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  },
